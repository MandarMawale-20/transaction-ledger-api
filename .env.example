# Copy to .env (cp .env.example .env). Loaded automatically on startup.
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledger

# Used only by pytest. The database name must contain "test": tests TRUNCATE tables.
TEST_DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledger_test

# Connection pool (keep above the number of concurrent requests you expect)
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
