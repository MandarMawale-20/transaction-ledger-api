                        "title": "Transfer Id"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Created At"
                    },
                    "duplicate": {
                        "type": "boolean",
                        "title": "Duplicate",
                        "default": false
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "account_id",
                    "type",
                    "amount",
                    "description",
                    "reference_id",
                    "transfer_id",
                    "created_at"
