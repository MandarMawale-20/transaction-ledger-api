                    "type",
                    "amount",
                    "description",
                    "reference_id",
                    "transfer_id",
                    "created_at"
                ],
                "title": "TransactionOut"
            },
            "TransactionPage": {
                "properties": {
                    "items": {
                        "items": {
                            "$ref": "#/components/schemas/TransactionOut"
                        },
                        "type": "array",
                        "title": "Items"
                    },
                    "total": {
                        "type": "integer",
